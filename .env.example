# Public origin used for sitemap and robots output when no request host exists.
# Leave blank during local development and set it only when hosting is approved.
NEXT_PUBLIC_SITE_URL=

# Supabase Project Connect values. The publishable key is safe for browser use;
# never add a secret or service_role key to a NEXT_PUBLIC variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare Turnstile protects public enquiry and story-comment forms. The
# site key is public; the secret key must remain server-side only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional dashboard email notifications for new enquiries and comments.
# RESEND_FROM_EMAIL must use a sender/domain verified in Resend. Multiple
# administrator recipients can be comma-separated.
RESEND_API_KEY=
RESEND_FROM_EMAIL="SLNA Website <website@your-verified-domain.example>"
ADMIN_NOTIFICATION_EMAIL=

# Future Mwangi Ngugi portfolio URL. The footer remains a text credit until set.
NEXT_PUBLIC_CREATOR_PORTFOLIO_URL=
